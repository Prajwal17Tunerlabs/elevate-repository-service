		"node": ">=20.0.0",
		"npm": ">=10.0.0"
	},
	"dependencies": {
		"body-parser": "1.20.3",
		"cors": "2.8.5",
		"dotenv": "8.6.0",
		"elevate-logger": "3.1.0",
		"elevate-services-health-check": "0.0.10",
		"express": "4.21.2",
		"express-fileupload": "1.5.2",
		"express-validator": "5.3.1",
		"fs-extra": "9.0.1",
		"kafka-node": "4.1.3",
		"lodash": "4.17.21",
		"md5": "2.3.0",
		"module-alias": "2.2.3",
		"moment": "2.30.1",
		"moment-timezone": "0.5.48",
		"@temporalio/activity": "^1.11.0",
		"@temporalio/client": "^1.11.0",
		"@temporalio/worker": "^1.11.0",
		"@temporalio/workflow": "^1.11.0",
