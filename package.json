{
	"name": "elevate-repository-service",
	"version": "1.0.0",
	"description": "Elevate Repository Service",
	"main": "app.js",
	"scripts": {
		"start": "NODE_ENV=development nodemon app.js",
		"prod": "NODE_ENV=production node app.js",
		"stage": "NODE_ENV=stage node app.js",
		"qa": "NODE_ENV=qa node app.js",
		"dev": "nodemon app.js",
		"worker": "node temporal/worker.js",
		"prepare": "husky install"
	},
	"keywords": ["elevate"],
	"author": "Shikshalokam",
	"license": "ISC",
