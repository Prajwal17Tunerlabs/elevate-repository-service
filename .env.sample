# Application
APPLICATION_PORT=3000
APPLICATION_ENV=development
API_BASE_URL=/api

# API Documentation
API_DOC_URL=/api-docs

# PostgreSQL
POSTGRES_HOST=localhost
POSTGRES_PORT=5432
POSTGRES_DB=elevate_repository_service
POSTGRES_USER=postgres
POSTGRES_PASSWORD=postgres

# Temporal
TEMPORAL_ON=OFF
TEMPORAL_ADDRESS=localhost:7233
TEMPORAL_NAMESPACE=default
TEMPORAL_TASK_QUEUE=elevate-repository-queue

# Kafka
KAFKA_COMMUNICATIONS_ON=OFF
KAFKA_URL=localhost:9092
KAFKA_GROUP_ID=elevate-repository

# Kafka Topics
KAFKA_TOPIC_SAMPLE=sample-topic

# Auth
INTERNAL_ACCESS_TOKEN=internal-secret
ENCRYPTION_SECRET=

# Google Drive OAuth
GOOGLE_DRIVE_CLIENT_ID=
GOOGLE_DRIVE_CLIENT_SECRET=
GOOGLE_DRIVE_TOKEN_URL=https://oauth2.googleapis.com/token

# OneDrive OAuth
ONE_DRIVE_TENANT_ID=
ONE_DRIVE_CLIENT_ID=
ONE_DRIVE_CLIENT_SECRET=
ONE_DRIVE_TOKEN_URL=https://login.microsoftonline.com/<tenant-id>/oauth2/v2.0/token

# External Services
USER_SERVICE_URL=http://localhost:3001
ENTITY_MANAGEMENT_URL=http://localhost:3004
INTERFACE_SERVICE_URL=http://localhost:3002

# Internal Access Token
INTERNAL_CACHE_EXP_TIME=86400

# Timezone
TIMEZONE_OFFSET=+05:30

# Cloud Storage (AWS / GCP / Azure / OCI)
CLOUD_STORAGE=AWS
AWS_BUCKET_NAME=
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_BUCKET_REGION=
GCP_BUCKET_NAME=
GCP_PATH=
AZURE_ACCOUNT_NAME=
AZURE_ACCOUNT_KEY=
AZURE_CONTAINER_NAME=
OCI_BUCKET_NAME=
OCI_ACCESS_KEY_ID=
OCI_SECRET_ACCESS_KEY=
OCI_BUCKET_REGION=
OCI_BUCKET_ENDPOINT=

# URL expiry (in seconds)
SIGNED_URL_EXPIRY=300
